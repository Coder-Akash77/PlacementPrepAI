# Copy this file to .env and fill in your values
GEMINI_API_KEY=your_gemini_api_key_here
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
HISTORY_DB_PATH=./data/history.db

# Postgres (e.g. Supabase pooler URL). Leave empty to use local SQLite.
DATABASE_URL=
# Google OAuth Web client ID (same value as the frontend's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Long random string used to sign login sessions, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SESSION_SECRET=change_me
